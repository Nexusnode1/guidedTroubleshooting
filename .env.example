# Application configuration placeholder. Do not commit a populated .env file.
APP_ENV=development
LOG_LEVEL=INFO

# External AI providers. All optional: with no keys set, the app runs rules-only.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# auto: use configured providers in AI_PROVIDER_ORDER; local: never call an external provider.
AI_PROVIDER_MODE=auto
AI_PROVIDER_ORDER=gemini,groq,openrouter

# Gemini model id and per-request timeout in seconds (0 < value <= 120).
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=8

# Groq model id and per-request timeout in seconds (0 < value <= 120).
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=8
